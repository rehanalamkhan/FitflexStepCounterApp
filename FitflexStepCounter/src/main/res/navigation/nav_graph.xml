<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@+id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.step.counter.features.home.presentation.StepCounterHomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/step_counter_fragment_home">

        <action
            android:id="@+id/homeFragmentToSettingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.step.counter.features.settings.presentation.StepCounterSettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/step_counter_fragment_settings"/>
</navigation>